# =============================================================================
# Trosky — Environment Variables
#
# Local dev: `pnpm dev` runs only the Next.js app (avoids Redis/worker noise).
# Full stack (web + BullMQ worker): start Redis, then `pnpm dev:full`.
# External drives / EMFILE watcher errors: root `dev` sets NEXT_DEV_POLLING — override in package.json if unused.
# Raise macOS file limit if needed: ulimit -n 10240
# Copy this file to .env and fill in values before running the app.
#
# Production (e.g. Vercel): set the same keys in Project → Settings → Environment Variables.
# Required: DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET (openssl rand -hex 32 for each).
# Optional: REDIS_URL — needed if you run apps/worker for scrapes (worker is not deployed with Next.js).
# Prefer 127.0.0.1 over localhost on macOS (IPv4 vs ::1).
# =============================================================================

# --- Database (required) ---
# PostgreSQL connection string. Docker default shown; replace with Neon/Supabase/etc. for hosted.
#
# SERVERLESS (Vercel): use the POOLED endpoint and cap the per-instance pool, or
# concurrent lambdas will exhaust the database's connection limit:
#   postgresql://user:pw@ep-xxx-pooler.REGION.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# Migrations need the DIRECT (non-pooled) endpoint — see DIRECT_DATABASE_URL below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_pricing

# Non-pooled connection used only by `prisma migrate deploy` (pgbouncer cannot
# run DDL in the transaction mode Prisma needs). Local dev can leave this unset.
# DIRECT_DATABASE_URL=postgresql://user:pw@ep-xxx.REGION.aws.neon.tech/db?sslmode=require

# --- Redis (optional) ---
# Required for scrape jobs, hotel refresh, and recommendation recompute.
# Without it, the app works but "Run scrape now" and "Refresh" return errors.
REDIS_URL=redis://127.0.0.1:6379

# --- Authentication (required in production) ---
# JWT signing secrets. MUST be long random strings in production.
# Generate with: openssl rand -hex 32
# WARNING: The app will crash on startup if these are missing in production.
#
# Rotating either secret logs everyone out immediately (existing tokens stop
# verifying). Sessions are also revocable per-user without rotating: logout,
# password change, or deactivation bumps User.tokenVersion, which invalidates
# every token that user holds.
JWT_SECRET=change-me-to-a-random-64-char-string-in-production-1234567890
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string-in-production-abc

# --- Security headers (optional) ---
# The Content-Security-Policy is ENFORCED by default and uses a per-request
# nonce. Set to "report-only" to downgrade to browser console warnings while
# adding a third-party embed that the policy would otherwise block.
# CSP_MODE=report-only

# --- Ops (optional) ---
# /api/health returns only {status, ready} to anonymous callers in production.
# Set this and pass it as the `x-health-token` header (or ?token=) to see the
# full config/DB breakdown. Unset outside production means full detail.
# HEALTH_DETAIL_TOKEN=

# Log every Prisma query. Never enable in production — queries contain guest and
# rate data that would land in your log provider.
# PRISMA_LOG_QUERIES=true

# --- Scraping ---
# "mock" = deterministic fake prices (no Playwright needed, good for demos)
# "real" = Playwright-based OTA scraping (requires browser install)
SCRAPE_MODE=mock

# --- AI (optional) ---
# Set one or both for AI-powered rate explanations and inquiry analysis.
# Without these, recommendations and inquiries use deterministic fallback logic.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Inquiry AI provider placeholders. Keep "heuristic" until a model provider is enabled.
INQUIRY_AI_PROVIDER=heuristic
# INQUIRY_AI_MODEL=gpt-4o-mini

# Inquiry feature flags (optional). Omit or set to "true" for demo/MVP defaults.
# Set to "false" to disable automatic heuristic analysis on the public /api/inquiries/public endpoint.
# INQUIRY_PUBLIC_AI_ANALYSIS=false
# Set to "false" to hide the "Analyze" button and skip staff-triggered analysis in the app inbox.
# INQUIRY_UI_ANALYZE=false

# --- Business rules ---
# Discount warning thresholds (percentages). Warnings appear in Day Detail modal
# and dashboard when ADR drops too far below BAR or discount share is too high.
DISCOUNT_ADR_THRESHOLD=12
DISCOUNT_SHARE_THRESHOLD=35

# --- UI (optional) ---
# Show demo login credentials on the login page. Only set to "true" for demos/staging.
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# --- Demo data (optional) ---
# Controls visibility of seed/demo RevenueActions on dashboard, /actions, rate calendar, and evidence drawer.
# Production: keep false (or unset) unless intentionally running a demo tenant.
# Local development: demo actions are visible by default when unset; set false to test production-like behaviour.
# Demo Vercel tenants: set TROSKY_DEMO_MODE=true or the command centre will look empty after seed
# (seeded actions are filtered out; live actions need REDIS_URL + the worker).
# Demo data must never be treated as live hotel intelligence.
# TROSKY_DEMO_MODE=true
