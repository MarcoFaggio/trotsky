{
  "name": "hotel-pricing",
  "private": true,
  "scripts": {
    "dev": "ulimit -n 10240 2>/dev/null; NEXT_DEV_POLLING=1 turbo dev --filter=@hotel-pricing/web",
    "dev:web": "ulimit -n 10240 2>/dev/null; NEXT_DEV_POLLING=1 turbo dev --filter=@hotel-pricing/web",
    "dev:full": "NEXT_DEV_POLLING=1 turbo dev",
    "dev:stack": "docker compose up -d && NEXT_DEV_POLLING=1 turbo dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:migrate": "pnpm --filter @hotel-pricing/db db:migrate",
    "db:migrate:deploy": "pnpm exec dotenv -e .env -- pnpm --filter @hotel-pricing/db exec prisma migrate deploy",
    "db:push": "pnpm exec dotenv -e .env -- pnpm --filter @hotel-pricing/db exec prisma db push",
    "db:seed": "pnpm exec dotenv -e .env -- pnpm --filter @hotel-pricing/db db:seed",
    "db:generate": "pnpm --filter @hotel-pricing/db db:generate",
    "db:studio": "pnpm exec dotenv -e .env -- pnpm --filter @hotel-pricing/db db:studio",
    "cleanup:appledouble": "python3 scripts/cleanup-macos-appledouble.py ."
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
